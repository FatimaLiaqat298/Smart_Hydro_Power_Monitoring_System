# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Smart Hydro Power Monitoring & Forecasting System (SHPMFS)"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5000","*"]

# External Model Service URLs
MODEL_FORECAST_URL=http://localhost:8001/api/forecast
MODEL_ANOMALY_URL=http://localhost:8002/api/anomaly

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@shpmfs.gov.pk
ADMIN_EMAIL=admin@shpmfs.gov.pk

# Storage Bucket
SUPABASE_REPORTS_BUCKET=reports
